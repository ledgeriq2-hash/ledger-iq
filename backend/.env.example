# Ledger IQ backend environment (EXAMPLE)
# Copy to one of these (git-ignored) files:
# - repo root: `.env.development` or `.env.test`
# - backend dir: `backend/.env.development` or `backend/.env.test`
# Or set `ENV_FILE` to an explicit path.

APP_NAME="Ledger IQ"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# CSRF protection (double-submit cookie).
# Tip: In local dev, `/api/v1/ai/*` POSTs are CSRF-exempt, but other unsafe endpoints still require CSRF (or set CSRF_ENABLED=false).
CSRF_ENABLED=false

# ======================
# Database & Cache
# ======================
# Local dev default (docker-compose):
DATABASE_URL=postgresql+asyncpg://ledgeriq:ledgeriq_password@localhost:5432/ledgeriq
# Optional (SQLite, dev/test only):
# DATABASE_URL=sqlite+aiosqlite:///./ledgeriq.db

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# ======================
# URLs / CORS
# ======================
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SENTRY_DSN=

# ======================
# Auth / JWT
# ======================
# Required in production; safe placeholders for local dev.
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=30

# ======================
# Feature flags
# ======================
SOFT_LAUNCH_ENABLED=false
SOFT_LAUNCH_TENANT_SLUGS=[]
SHOW_SOFT_LAUNCH_BADGE=true
DEFAULT_PLAN_CODE=free
ALLOW_NEGATIVE_STOCK=false

# ======================
# Rate limits
# ======================
AUTH_RATE_LIMIT_PER_MINUTE=60
PORTAL_RATE_LIMIT_PER_MINUTE=120
FEEDBACK_RATE_LIMIT_PER_MINUTE=30

# ======================
# Retention
# ======================
FEEDBACK_RETENTION_DAYS=60
ERROR_EVENT_RETENTION_DAYS=30
GDPR_EXPORT_TTL_DAYS=7
GDPR_FINANCIAL_RETENTION_DAYS=0

# ======================
# Email (optional)
# ======================
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=dev@example.com
EMAIL_TLS=true
EMAIL_SSL=false

# ======================
# Billing / Stripe
# ======================
# Required in production when BILLING_ENABLED=true.
BILLING_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=

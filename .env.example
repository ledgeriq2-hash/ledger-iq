# Sample environment configuration for Ledger IQ.
# Copy to .env.development or .env.test and export before running locally.
APP_NAME=Ledger IQ
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://ledgeriq_user:ledgeriq_password@localhost:5432/ledgeriq
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000

JWT_SECRET_KEY=change-me-jwt
JWT_REFRESH_SECRET_KEY=change-me-refresh
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=30

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
SENTRY_DSN=
SOFT_LAUNCH_ENABLED=false
SOFT_LAUNCH_TENANT_SLUGS=demo-ledger
SHOW_SOFT_LAUNCH_BADGE=true
DEFAULT_PLAN_CODE=free
AUTH_RATE_LIMIT_PER_MINUTE=60
PORTAL_RATE_LIMIT_PER_MINUTE=120
FEEDBACK_RATE_LIMIT_PER_MINUTE=30
FEEDBACK_RETENTION_DAYS=60
ERROR_EVENT_RETENTION_DAYS=30

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_TLS=true
EMAIL_SSL=false

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=

VITE_API_URL=http://localhost:8000/api/v1
ALLOW_NEGATIVE_STOCK=false

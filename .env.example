# Runtime mode controls
ENVIRONMENT=production
APP_ENV=production
FEATURE_OPTIONAL_ROUTES=true

# Postgres credentials used by both Docker and the backend app
POSTGRES_DB=ledgeriq
POSTGRES_USER=ledgeriq
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://ledgeriq:change-me@db:5432/ledgeriq

# Redis connection used by Celery & FastAPI
REDIS_URL=redis://redis:6379/0

# Frontend + CORS
FRONTEND_URL=http://localhost
BACKEND_CORS_ORIGINS=http://localhost

# JWT secrets (must be strong in production)
JWT_SECRET_KEY=replace-with-a-secret
JWT_REFRESH_SECRET_KEY=replace-with-another-secret
JWT_ALGORITHM=HS256

# Logging + observability
LOG_LEVEL=INFO
SENTRY_DSN=

# CSRF + cookies (adjust only if you understand the implications)
CSRF_ENABLED=true
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token

# Email delivery (leave blank if unused)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@example.com
EMAIL_PASSWORD=change-me
EMAIL_FROM=no-reply@example.com
EMAIL_TLS=true
EMAIL_SSL=false

# Billing / Stripe (placeholders)
BILLING_ENABLED=true
STRIPE_API_KEY=sk_live_XXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX
STRIPE_PRICE_FREE=price_XXXX
STRIPE_PRICE_PRO=price_YYYY

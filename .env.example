# Ledger IQ environment (example for local + Docker)
# Copy to .env.local or .env.development to customize.

APP_NAME=Ledger IQ
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Postgres (Docker)
POSTGRES_DB=ledgeriq
POSTGRES_USER=ledgeriq
POSTGRES_PASSWORD=ledgeriq_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ledgeriq:ledgeriq_password@postgres:5432/ledgeriq

# Redis
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# URLs / CORS
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SENTRY_DSN=

# Auth / JWT
JWT_SECRET_KEY=dev-jwt-secret-key
JWT_REFRESH_SECRET_KEY=dev-jwt-refresh-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/
REFRESH_COOKIE_SECURE=false

# CSRF
CSRF_ENABLED=false
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_EXEMPT_PATHS=["/api/v1/auth/login","/api/v1/auth/register","/api/v1/billing/webhook"]

# Feature flags
FEATURE_OPTIONAL_ROUTES=true
SOFT_LAUNCH_ENABLED=false
SOFT_LAUNCH_TENANT_SLUGS=[]
SHOW_SOFT_LAUNCH_BADGE=true
DEFAULT_PLAN_CODE=free
ALLOW_NEGATIVE_STOCK=false

# Rate limits
AUTH_RATE_LIMIT_PER_MINUTE=60
PORTAL_RATE_LIMIT_PER_MINUTE=120
FEEDBACK_RATE_LIMIT_PER_MINUTE=30

# Retention
FEEDBACK_RETENTION_DAYS=60
ERROR_EVENT_RETENTION_DAYS=30
GDPR_EXPORT_TTL_DAYS=7
GDPR_FINANCIAL_RETENTION_DAYS=0

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=dev@example.com
EMAIL_TLS=true
EMAIL_SSL=false

# Billing / Stripe (optional)
BILLING_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_PRO=

# Frontend (Vite)
VITE_API_ORIGIN=http://localhost:8000
VITE_API_BASE=/api
VITE_TENANT_ID=
VITE_ACTOR_ID=
